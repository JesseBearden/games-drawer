# Caddy config for a game server box; setup.sh writes it to /etc/caddy/Caddyfile.
#
# HTTPS ends at CloudFront (the front door, infra/lib/edge.ts), which talks to this box in plain
# HTTP on port 80; only CloudFront and our other boxes can reach that port. Caddy then sends each
# request to the right box: a table's own box (its code says which, as ?slot=), the newest box
# for staging, and new tables wherever the fleet map says. games-drawer-routes.caddy holds those
# routes; the rollout tool rewrites it from the fleet map (deploy/fleetMap.ts).

{
	auto_https off
	admin localhost:2019
}

:80 {
	encode zstd gzip

	# Server stats are for the rollout tool on the box only.
	handle /stats* {
		respond 404
	}
	import /etc/caddy/games-drawer-routes.caddy
}
