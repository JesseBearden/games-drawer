# The game server on one box. %i is the box's slot (a-d). setup.sh installs this as
# /etc/systemd/system/games-drawer@.service; the rollout tool writes the slot's env file.
[Unit]
Description=Games Drawer server (slot %i)
After=network-online.target remote-fs.target
Wants=network-online.target
# Jigsaw saves and logs live on the shared disk (EFS), so a box can be replaced without losing them.
RequiresMountsFor=/mnt/games-drawer

[Service]
User=games
Group=games
EnvironmentFile=/etc/games-drawer/common.env
EnvironmentFile=/etc/games-drawer/secrets.env
# The admin page's password hash, from Parameter Store (games-drawer-deploy fetches it).
EnvironmentFile=-/etc/games-drawer/admin.env
EnvironmentFile=/etc/games-drawer/slot-%i.env
ExecStart=/usr/local/bin/node ${RELEASE_DIR}/server.mjs
# A crash restarts it; finishing a drain (exit 0) does not.
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
MemoryMax=450M
LimitNOFILE=8192
# Lock it down: it only needs to listen on localhost and write to the shared disk.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
ReadWritePaths=/mnt/games-drawer

[Install]
WantedBy=multi-user.target
