# The game server on one box. %i is the box's slot (a-d). setup.sh installs this as
# /etc/systemd/system/games-drawer@.service; the rollout tool writes the slot's env file.
[Unit]
Description=Games Drawer server (slot %i)
After=network-online.target remote-fs.target
Wants=network-online.target
# Jigsaw saves and logs live on the shared disk (EFS), so a box can be replaced without losing them.
RequiresMountsFor=/mnt/games-drawer
# Keep restarting a crashed server however often it happens (systemd otherwise gives up after five
# in ten seconds, e.g. while the shared disk is still coming back). A retiring box turns restarts
# off (deploy/rollout.ts).
StartLimitIntervalSec=0

[Service]
User=games
Group=games
EnvironmentFile=/etc/games-drawer/common.env
EnvironmentFile=/etc/games-drawer/secrets.env
# The admin page's password hash, from Parameter Store (games-drawer-deploy fetches it).
EnvironmentFile=-/etc/games-drawer/admin.env
EnvironmentFile=/etc/games-drawer/slot-%i.env
ExecStart=/usr/local/bin/node ${RELEASE_DIR}/server.mjs
# File reads and writes run on Node's worker threads (4 by default). The shared disk is mounted
# "hard", so when it stalls, every waiting read and write waits with it: with only 4, a stall
# stops the server sending its pages and pictures too. 16 leaves room for those.
Environment=UV_THREADPOOL_SIZE=16
# A crash restarts it; finishing a drain (exit 0) does not.
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
MemoryMax=450M
LimitNOFILE=8192
# Lock it down: it only needs to listen on localhost and write to the shared disk.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
ReadWritePaths=/mnt/games-drawer

[Install]
WantedBy=multi-user.target
